# ==============================================================
# Kanji Master (N5 - N1) Production Environment Configuration
# ==============================================================

# 1. Database Connection:
# Khi dùng Vercel Postgres / Neon, Vercel sẽ tự động tạo và gán biến này:
POSTGRES_URL=postgres://default:password@ep-sample-12345.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# (Tùy chọn) Nếu chạy cục bộ không dùng Postgres, hệ thống sẽ tự động dùng SQLite:
# KANJI_DB_PATH=kanji_users.db

# 2. JWT Secret Key (Tạo một chuỗi ngẫu nhiên 32+ ký tự để ký token đăng nhập):
JWT_SECRET_KEY=kanji-rev-production-secret-jwt-key-2026-secure-random

# 3. Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console -> APIs & Credentials):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
